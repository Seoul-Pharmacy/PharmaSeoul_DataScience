import numpy as np
from haversine import haversine
from sklearn.neighbors import NearestNeighbors

logger = logging.getLogger('django')

def filter_by_location(datas, user_lat, user_lon, k=5):
    logger.info("machine_learning.filter_by_location() optimized")
    
    if not datas:
        return []

    # 1. 좌표 데이터 벡터화
    coords = np.array([[float(d['latitude']), float(d['longitude'])] for d in datas])
    user_coord = np.array([[float(user_lat), float(user_lon)]])

    # 2. 검색할 이웃 수 결정 (데이터가 k개보다 적을 경우 대비)
    n_neighbors = min(len(datas), k)

    # 3. NearestNeighbors 사용 
    dist_diff = coords - user_coord
    # 단순 유클리드 거리 제곱으로 근사치(Top K)를 빠르게 뽑습니다.
    approx_distances = np.sum(dist_diff**2, axis=1)
    nearest_indexes = np.argsort(approx_distances)[:n_neighbors]

    results = []
    for idx in nearest_indexes:
        target_data = datas[idx]
        # 실제 정확한 거리 계산 (km)
        real_dist = haversine((float(user_lat), float(user_lon)), 
                              (float(target_data['latitude']), float(target_data['longitude'])))
        
        target_data["distance"] = format_distance(real_dist)
        results.append(target_data)

    return results

def format_distance(dist_km):
    if dist_km < 1:
        return f"{round(dist_km * 1000, 2)}m"
    return f"{round(dist_km, 2)}km"
